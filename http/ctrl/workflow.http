###
### Add
###
POST {{root}}/api/ctrl/v1/workflows/add
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "environmentId": "{{envId}}",
  "workflowName": "{{wrkName}}"
}

###
### Remove
###
POST {{root}}/api/ctrl/v1/workflows/remove
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "workflowId": "{{wrkId}}"
}

###
### Fetch
###
POST {{root}}/api/ctrl/v1/workflows/fetch
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "workflowId": "{{wrkId}}"
}

###
### Search
###
POST {{root}}/api/ctrl/v1/workflows/search
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "query": null,
  "lastId": null,
  "pageSize": null,
  "ascending": true,
  "orderBy": null,
  "environmentId": "{{envId}}"
}

###
### Add Version Step
###
POST {{root}}/api/ctrl/v1/workflows/versions/add-step
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "workflowId": "{{wrkId}}",
  "workflowVersionId": "v4vcm4tppn5e07ynh1iuwcin"
}

###
### Remove Version Step
###
POST {{root}}/api/ctrl/v1/workflows/versions/remove-step
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "workflowId": "{{wrkId}}",
  "workflowVersionId": "v4vcm4tppn5e07ynh1iuwcin",
  "workflowVersionStepId": "5lkd32lce3189kek45nk9qhoj"
}