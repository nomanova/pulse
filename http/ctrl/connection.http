###
### Search
###
POST {{root}}/api/ctrl/v1/connections/search
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "lastId": null,
  "pageSize": null,
  "ascending": true,
  "environmentId": "{{envId}}",
  "status": null
}

###
### Remove
###
POST {{root}}/api/ctrl/v1/connections/remove
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "connectionId": "{{conId}}"
}