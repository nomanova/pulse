###
### Add
###
POST {{root}}/api/ctrl/v1/applications/add
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "organizationId": "{{org.id}}",
  "applicationName": "{{app.name}}",
  "applicationKey": "{{app.key}}"
}

###
### Remove
###
POST {{root}}/api/ctrl/v1/applications/remove
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "applicationId": "{{app.id}}"
}

###
### Fetch
###
POST {{root}}/api/ctrl/v1/applications/fetch
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "applicationId": "{{app.id}}"
}

###
### Search
###
POST {{root}}/api/ctrl/v1/applications/search
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "query": null,
  "lastId": null,
  "pageSize": null,
  "ascending": true,
  "orderBy": null,
  "organizationId": "{{org.id}}"
}
