<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <ProjectGuid>{06114962-D453-49F7-BD81-523006332E2F}</ProjectGuid>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8"/>
        <PackageReference Include="Scalar.AspNetCore" Version="2.14.11"/>
        <PackageReference Include="Serilog.AspNetCore" Version="10.0.0"/>
        <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0"/>
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="appsettings.json" CopyToOutputDirectory="Always"/>
    </ItemGroup>

    <ItemGroup Condition="Exists('appsettings.Local.json')">
        <None Include="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\infrastructure\Pulse.Infra\Pulse.Infra.csproj"/>
        <ProjectReference Include="..\Pulse.Api.Ctrl\Pulse.Api.Ctrl.csproj"/>
        <ProjectReference Include="..\Pulse.Api.Data\Pulse.Api.Data.csproj"/>
    </ItemGroup>

    <!-- Core plugins -->
    <Target Name="BuildPluginProjects" BeforeTargets="Build">
        <ItemGroup>
            <PluginProject Include="..\..\plugins\Pulse.Plugin.Provider.Email.Console\Pulse.Plugin.Provider.Email.Console.csproj"/>
            <PluginProject Include="..\..\plugins\Pulse.Plugin.Provider.Email.SendGrid\Pulse.Plugin.Provider.Email.SendGrid.csproj"/>
            <PluginProject Include="..\..\plugins\Pulse.Plugin.Provider.Sms.Console\Pulse.Plugin.Provider.Sms.Console.csproj"/>
        </ItemGroup>

        <MSBuild
                Projects="@(PluginProject)"
                Targets="Build"
                Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)"/>
    </Target>

    <Target Name="CopyPluginOutputs" AfterTargets="Build">
        <ItemGroup>
            <PluginOutput Include="..\..\plugins\Pulse.Plugin.Provider.Email.Console\bin\$(Configuration)\$(TargetFramework)\**\*.*">
                <PluginName>Pulse.Plugin.Provider.Email.Console</PluginName>
            </PluginOutput>
            <PluginOutput Include="..\..\plugins\Pulse.Plugin.Provider.Email.SendGrid\bin\$(Configuration)\$(TargetFramework)\**\*.*">
                <PluginName>Pulse.Plugin.Provider.Email.SendGrid</PluginName>
            </PluginOutput>
            <PluginOutput Include="..\..\plugins\Pulse.Plugin.Provider.Sms.Console\bin\$(Configuration)\$(TargetFramework)\**\*.*">
                <PluginName>Pulse.Plugin.Provider.Sms.Console</PluginName>
            </PluginOutput>
        </ItemGroup>

        <Copy
                SourceFiles="@(PluginOutput)"
                DestinationFiles="@(PluginOutput->'$(OutDir)plugins\%(PluginName)\%(RecursiveDir)%(Filename)%(Extension)')"
                SkipUnchangedFiles="true"/>
    </Target>

</Project>
