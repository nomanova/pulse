@inherits CmpFocusOnOpen<AddApplicationViewModel>

<CmpDrawer
    Title="Add application"
    ActionText="Add"
    OnAction="@OnSubmit"
    @bind-IsOpen="@ViewModel.IsOpen"
    @bind-Error="@ViewModel.Error"
    IsLoading="@ViewModel.IsSubmitting">

    <div class="px-6">
        @if (ViewModel.IsOpen)
        {
            <MudForm Model="@ViewModel.Model"
                     @ref="@(_form)"
                     Validation="@(ViewModel.ModelValidator.ValidateValue)"
                     ValidationDelay="0"
                     FieldChanged="@(() => ViewModel.FieldChangedCommand.Execute(null))">

                <MudTextField @ref="@_nameField"
                              @bind-Value="@ViewModel.Model.Name"
                              For="@(() => ViewModel.Model.Name)"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              MaxLength="@Validators.MaxNameLength"
                              Required="true"
                              Disabled="@ViewModel.IsSubmitting"
                              Label="Name"/>

                <MudTextField @bind-Value="@ViewModel.Model.Key"
                              For="@(() => ViewModel.Model.Key)"
                              Variant="Variant.Outlined"
                              Immediate="false"
                              MaxLength="@Validators.MaxKeyLength"
                              Required="true"
                              Disabled="@ViewModel.IsSubmitting"
                              Label="Key"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.HelpOutline"
                              OnAdornmentClick="@(() => ViewModel.KeyHelpCommand.Execute(null))"/>
            </MudForm>
        }
    </div>

</CmpDrawer>

@code {

    private MudForm _form = null!;
    private MudTextField<string>? _nameField;

    protected override bool IsOpen => ViewModel.IsOpen;

    protected override async Task FocusOnOpenAsync()
    {
        if (_nameField is not null)
        {
            await _nameField.FocusAsync();
        }
    }

    private async Task OnSubmit()
    {
        await _form.ValidateAsync();

        if (_form.IsValid)
        {
            await ViewModel.SubmitCommand.ExecuteAsync(null);
        }
    }

}