@using Pulse.App.Dto.Applications
@using Pulse.Web.Common.Components.Icons

<div class="@CardClasses()" @onclick="OnSelected">

    <div class="flex justify-center">
        <CmpIcon HasBackground="false"/>
    </div>
    <MudCardContent>
        <div class="flex align-center">
            <MudText Typo="Typo.h6" Class="app-card-label">@Application.Name</MudText>

            <div class="grow"></div>
            
            <MudTooltip Text="Remove">
                <MudIconButton
                    Icon="@Icons.Material.Filled.Delete"
                    Color="Color.Default"
                    Size="Size.Medium"
                    OnClick="@OnRemoveSelected"/>
            </MudTooltip>
        </div>
    </MudCardContent>
</div>

@code {

    [Parameter] public required ApplicationDto Application { get; set; }

    [Parameter] public bool FixedWidth { get; set; }

    [Parameter] public EventCallback<string> OnClick { get; set; }

    [Parameter] public EventCallback<ApplicationDto> OnRemove { get; set; }

    private const string FixedWidthClasses = "app-card";
    private const string StretchedWidthClasses = "app-card app-card-stretch";

    private async Task OnSelected()
    {
        await OnClick.InvokeAsync(Application.Id);
    }

    private async Task OnRemoveSelected()
    {
        await OnRemove.InvokeAsync(Application);
    }

    private string CardClasses()
    {
        return FixedWidth ? FixedWidthClasses : StretchedWidthClasses;
    }

}