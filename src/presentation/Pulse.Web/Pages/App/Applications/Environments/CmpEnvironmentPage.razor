@inherits MvvmCmpBase<EnvironmentContainerViewModel>

<AddEnvironmentDrawer/>

<div class="env-wrapper">
    <div class="env-topbar">
        <CmpEnvironmentTopBar ApplicationName="@ViewModel.ApplicationName" 
                              EnvironmentName="@ViewModel.EnvironmentName"
                              EnvironmentId="@ViewModel.EnvironmentId"
                              Environments="@ViewModel.Environments"
                              ApplicationId="@ViewModel.ApplicationId"/>
    </div>
    <div class="env-body">
        <div class="env-sidebar">
            <CmpEnvironmentMenu
                OrganizationId="@OrganizationId"
                ApplicationId="@ApplicationId"
                EnvironmentId="@EnvironmentId"/>
        </div>
        <div class="env-content">
            @if (ViewModel.IsLoading)
            {
                <CmpLoader/>
            }
            else
            {
                @ChildContent
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public required string OrganizationId { get; set; }

    [Parameter] public required string ApplicationId { get; set; }

    [Parameter] public required string EnvironmentId { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await ViewModel.InitializeApplicationContext(OrganizationId, ApplicationId, EnvironmentId);
    }

}