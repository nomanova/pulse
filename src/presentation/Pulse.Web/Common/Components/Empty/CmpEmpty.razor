@using Pulse.Web.Common.Components.Icons
<div class="flex flex-col items-center">

    @if (ShowIcon)
    {
        <div class="@(Size == EmptySize.Dense ? "p-0 mb-4 bg-white" : "p-16 mb-8 bg-app-grey-50") flex justify-center items-center rounded-full">
            <div class="@(Size == EmptySize.Dense ? "w-14 h-14 stroke-[7] text-app-grey-200" : "w-36 h-36 stroke-[5.8] text-app-grey-300")">
                @((MarkupString)AppIcons.Box)
            </div>
        </div>
    }

    <MudText
        Class="@(Size == EmptySize.Dense ? "text-app-grey-800 font-medium text-lg" : "text-app-grey-800 font-medium text-xl")">@Title</MudText>
    <MudText Class="@(Size == EmptySize.Dense ? "text-app-grey-500" : "mt-2 text-app-grey-500")">@Subtitle</MudText>

    @if (Variant == EmptyVariant.Items)
    {
        <CmpButton
            Text="@Cta"
            Class="@(Size == EmptySize.Dense ? "mt-4" : "mt-8")"
            Variant="@(Size == EmptySize.Dense ? MudBlazor.Variant.Text : MudBlazor.Variant.Filled)"
            OnClick="@OnAddItem"/>
    }
</div>

@code {

    private const string SearchTitle = "No search results";
    private const string SearchSubtitle = "Try adjusting your search or filter to find what you're looking for.";
    private const string SearchSubtitleDense = "Try adjusting your search input.";

    private const string ItemsTitle = "No {0} defined";

    private const string ItemsSubtitleCanAdd = "Start adding {0} by clicking the button below.";

    [Parameter] public bool ShowIcon { get; set; } = true;

    [Parameter] public EmptyVariant Variant { get; set; } = EmptyVariant.Search;

    [Parameter] public EmptySize Size { get; set; } = EmptySize.Regular;

    [Parameter] public string? EntitySingular { get; set; }

    [Parameter] public string? EntityPlural { get; set; }

    [Parameter] public EventCallback OnAddItem { get; set; }

    private string Title
    {
        get
        {
            return Variant switch
            {
                EmptyVariant.Search => SearchTitle,
                EmptyVariant.Items => string.Format(ItemsTitle, EntityPlural),
                _ => throw new ArgumentOutOfRangeException()
            };
        }
    }

    private string Subtitle
    {
        get
        {
            if (Variant == EmptyVariant.Search)
            {
                return Size switch
                {
                    EmptySize.Regular => SearchSubtitle,
                    EmptySize.Dense => SearchSubtitleDense,
                    _ => throw new ArgumentOutOfRangeException()
                };
            }

            return string.Format(ItemsSubtitleCanAdd, EntityPlural);
        }
    }

    private string Cta => $"Add {EntitySingular}";
}