@inherits MvvmCmpBase<UserViewModel>

<MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
    <ActivatorContent>
        <MudButton OnClick="@context.ToggleAsync" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                   Class="rounded-0 pr-2"
                   Style="height: 48px" data-test-id="btn-appbar-user">
            <div class="d-flex align-center">
                <div style="display: inline-block">
                    <MudText Align="Align.Right" style="width: 100%; font-size: 14px; font-weight: bold;"
                             data-test-id="lbl-appbar-user">@(ViewModel.Username)</MudText>
                    @if (ViewModel.Organization != null)
                    {
                        <MudText Align="Align.Right" style="width: 100%; font-size: 11px;"
                                 data-test-id="lbl-appbar-organization">@(ViewModel.Organization)</MudText>
                    }
                </div>
                <div class="d-flex align-center pl-4">
                    <MudIcon Icon="@Icons.Material.Outlined.AccountCircle" Style="font-size: 24px;"/>
                </div>
            </div>
        </MudButton>
    </ActivatorContent>
    <ChildContent>
        @if (!string.IsNullOrEmpty(ViewModel.Organization))
        {
            <MudMenuItem
                OnClick="@(() => ViewModel.SwitchOrganizationCommand.Execute(null))"
                Icon="@Icons.Material.Filled.CompareArrows"
                IconColor="@Color.Tertiary"
                data-test-id="btn-appbar-user-switch-organization">
                Switch organization
            </MudMenuItem>
            <MudDivider/>
        }
        <MudMenuItem
            OnClick="@(() => ViewModel.SignOutCommand.Execute(null))"
            Icon="@Icons.Material.Filled.Logout"
            IconColor="@Color.Tertiary"
            data-test-id="btn-appbar-user-sign-out">
            Sign out
        </MudMenuItem>
    </ChildContent>
</MudMenu>