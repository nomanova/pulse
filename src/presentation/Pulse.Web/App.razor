@using Pulse.Web.Common.Components
@using Pulse.Web.Common.Layouts
@using Pulse.Web.Common.Navigation
@using Pulse.Web.Pages.Common

<MudThemeProvider Theme="Theme"/>
<MudDialogProvider/>
<MudSnackbarProvider/>
<MudPopoverProvider/>

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(CmpMainLayout)">
                <NotAuthorized>
                    <RedirectNotAuthorized/>
                </NotAuthorized>
                <Authorizing>
                    <CmpLoader/>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1"/>
        </Found>
    </Router>
</CascadingAuthenticationState>